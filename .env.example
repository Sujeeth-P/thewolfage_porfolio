# Copy to .env (never commit .env) and fill in.

# Google Apps Script web-app URL that receives the enquiry form (expects JSON, replies {"success": true}).
VITE_APP_SCRIPT=

# WhatsApp number with country code, digits only (e.g. 919876543210).
# Leave empty to hide the "Chat on WhatsApp" button.
VITE_WHATSAPP_NUMBER=
